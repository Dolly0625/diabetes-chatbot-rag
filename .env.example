# TFDA 模型配置（統一在 .env）
# 拷貝為 .env 後填入

# A Router Extractor（OpenCode Zen）
ROUTER_LLM_MODEL=opencode/qwen3-14b-opencode
# 可選: opencode/mimo-v2.5, opencode/qwen3-8b-opencode, opencode/gpt-oss:20b
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_API_KEY=

# Ollama 本地（對比測試，strict 支援度最好）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-14b-opencode

# Guard（選填）
# QWEN3GUARD_MODEL_ID=Qwen/Qwen3Guard-Gen-0.6B

# LINE ProductSession（正式環境建議使用獨立隨機值，至少 16 字元）
# 若留空但 LINE_CHANNEL_SECRET 已設定，Demo 會以 domain-separated HMAC 派生；
# channel secret 輪替時 session identity 會一起改變，因此正式部署不建議依賴派生值。
# LINE_IDENTITY_HASH_KEY=
LINE_SESSION_DB_PATH=data/processed/line_sessions.sqlite3
# 逗號分隔的 Demo 醫護帳號；正式環境替換為院方 SSO/OIDC
# DEMO_CLINICIAN_IDS=demo-doctor-01
# 正式病患頁：需建立 LINE Login / LIFF channel，後端會向 LINE 驗證 ID token
# LINE_LOGIN_CHANNEL_ID=
# LINE_LIFF_ID=
# 僅供本機／自動測試；公開部署不可設為 true
LINE_DEMO_ALLOW_ID_HEADERS=false
# 僅本機 webhook 測試可開啟；正式環境缺 secret 時必須 fail-closed
LINE_ALLOW_UNSIGNED_WEBHOOK=false
# Demo clinician header/allowlist 必須顯式啟用；正式環境維持 false 並改接 SSO/OIDC
LINE_DEMO_MODE=false
